# ============================================================
# Housekeeper Training System — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#
# Sprint Phase     Variables active
# ─────────────    ────────────────────────────────────
# Sprint 0–7       None required (Mock data only)
# Sprint 8         DATABASE_URL
# Sprint 9         ADMIN_USERNAME, ADMIN_PASSWORD, AUTH_SECRET
# Sprint 13        CLOUDINARY_*
# ============================================================

# ── Database (Sprint 8+) ─────────────────────────────
# PostgreSQL connection string for Prisma.
# DATABASE_URL="postgresql://user:password@localhost:5432/housekeeper_training?schema=public"

# ── Admin Auth (Sprint 9+) ───────────────────────────
# Simple environment-variable-based authentication for /admin.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="change-me-to-a-strong-password"
# AUTH_SECRET="generate-a-random-32-char-string-here"

# ── Cloudinary Image Upload (Sprint 13+) ─────────────
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="000000000000000"
# CLOUDINARY_API_SECRET="your-api-secret"
#
# Only the API Secret must stay server-side.
# The Upload Preset (unsigned) is configured in Cloudinary dashboard.

# ── Node Environment ─────────────────────────────────
NODE_ENV="production"

# ── Next.js ──────────────────────────────────────────
# Port for the Next.js server (default 3000)
# PORT=3000
